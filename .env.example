# Digital Facial Recognition Attendance System (PresentSync)
# Configuration Settings

# --- Flask & Security ---
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-to-a-strong-admin-password
ADMIN_EMAIL=admin@school.edu
COOKIE_SECURE=0
FLASK_DEBUG=0

# --- Storage / Data Directory ---
# Directory where attendance.db, dataset/, face_embeddings.npz, and train_status.json live.
# Defaults to the application directory (APP_DIR) for local runs. On Render with a Persistent Disk, set to /data.
# DATA_DIR=/data

# --- Email Notifications (SMTP) ---
# When a lecture ends, attendance confirmation emails are automatically
# dispatched to students who attended.
# To use Gmail: set SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and use an App Password.
# If left blank, emails will be safely simulated and logged without crashing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=1
MAIL_SENDER=attendance@school.edu
