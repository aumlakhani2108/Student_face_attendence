# BioBytes: Edge-Compatible Deep Facial Biometric Attendance & Academic Management System
# Configuration Settings

# --- Flask & Security ---
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-to-a-strong-admin-password
ADMIN_EMAIL=admin@biobytes.edu
COOKIE_SECURE=0
FLASK_DEBUG=0

# Student 2FA OTP Toggle (Set to 1 to require email OTP for students; 0 allows direct password login)
STUDENT_REQUIRE_OTP=0

# --- Storage / Data Directory ---
# Directory where attendance.db, dataset/, face_embeddings.npz, and train_status.json live.
# Defaults to the application directory (APP_DIR) for local runs. On Render with a Persistent Disk, set to /data.
# DATA_DIR=/data

# --- Real Email Dispatch Pipeline (SMTP) ---
# To send real verification OTPs and post-lecture attendance confirmations to actual emails:
# 1. For Gmail:
#    - Enable 2-Step Verification in your Google Account (myaccount.google.com/security)
#    - Generate an "App Password": myaccount.google.com/apppasswords (select app: Mail)
#    - Set:
#      SMTP_HOST=smtp.gmail.com
#      SMTP_PORT=587
#      SMTP_USER=your_email@gmail.com
#      SMTP_PASSWORD=your_16_character_app_password
#      SMTP_USE_TLS=1
#      MAIL_SENDER=your_email@gmail.com
#
# 2. For Outlook / Office 365:
#    SMTP_HOST=smtp.office365.com, SMTP_PORT=587, SMTP_USE_TLS=1
#
# If left blank, OTPs and receipts will run in simulated development mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=1
MAIL_SENDER=attendance@biobytes.edu
